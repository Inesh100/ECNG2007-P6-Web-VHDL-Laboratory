{
  "name": "p6a-editor-language-features",
  "version": "1.0.0",
  "description": "ECNG 2007 Group 6 - P6A Editor & Language Features (Web VHDL Laboratory)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lsp-server": "tsx simulator/server.ts",
    "build:lab": "node scripts/build-lab.mjs"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "^37.6.0",
    "@codingame/monaco-vscode-editor-api": "^37.6.0",
    "monaco-languageclient": "~11.0.3",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@^37.6.0",
    "vscode-languageclient": "~10.1.2",
    "vscode-languageserver": "~10.1.2",
    "vscode-languageserver-protocol": "~3.18.4",
    "vscode-ws-jsonrpc": "~4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "~8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "~5.0.4",
    "ws": "~8.22.0"
  },
  "overrides": {
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@^37.6.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
