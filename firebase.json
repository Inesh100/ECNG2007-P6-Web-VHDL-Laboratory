{
  "hosting": {
    "public": "site",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "**/*.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ] }
    ]
  }
}
